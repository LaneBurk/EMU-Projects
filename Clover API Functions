def getCustData(mID = mID, token = token, writecsv = False):
    url = f"https://api.clover.com/v3/merchants/{mID}/customers.csv"

    #Provides the token as credentials, sets permissions
    Headers = {
        "Accept" : "application/json",
        "Authorization" : f"Bearer {token}"
        }


    response = requests.get(url, headers=Headers)

    if writecsv:
        with open('customers.csv', 'wb') as f:
            f.write(response.content)
        print(f"Customer data written to %s" % pathlib.Path.cwd())
        return
    
    df = pd.read_csv(io.StringIO(response.text))
    return df

#Accessing data through JSON is required to pass parameters
def getCustDataJSON(mID = mID, token = token, writecsv = False):
    url = f"https://api.clover.com/v3/merchants/{mID}/customers"

    #Provides the token as credentials, sets permissions
    Headers = {
        "Accept" : "application/json",
        "Authorization" : f"Bearer {token}"
        }

    Params = {
    "limit": 1000,
    #"offset" : 5,
    #"filter" : [
    #    "customerSince>=1785542400000", #Unix stamp in miliseconds
    #    "firstName!="""],
    "filter" : "REWARDS_MEMBER",
    "orderBy": "firstName ASC"
    }

    #Allows orderBy parameter by translating space to %20 in url
    #doseq=True is required to allow multiple filters in list format
    query_string = urlencode(Params, quote_via=quote, doseq=True) 
    response = requests.get(f"{url}?{query_string}", headers=Headers)

    df = pd.json_normalize(response.json()["elements"])

    #Converts "Customer Since" from unix to %d-%b-%Y %I:%M %p %Z format ex 04-Aug-2026 02:22 PM EDT
    df["customerSince"] = df["customerSince"].apply(lambda x : datetime.fromtimestamp(x/1000, tz=ZoneInfo("America/New_York")).strftime("%d-%b-%Y %I:%M %p %Z"))
    
    if writecsv:
        df.to_csv("testdata2.csv")
        return
    return df


